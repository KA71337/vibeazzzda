# Server-only. Never prefix these with NEXT_PUBLIC_.

# Required for signing in at /admin.
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-bytes-and-do-not-reuse-the-password

# Required for reading and committing the catalog. Without these you can still
# sign in, but the product list is unavailable.
GITHUB_TOKEN=github-fine-grained-token
GITHUB_OWNER=KA71337
GITHUB_REPO=vibeazzzda

# Optional, shown with their defaults.
GITHUB_BRANCH=main
GITHUB_PRODUCTS_PATH=data/products.json
GITHUB_SALES_PATH=data/sales.json
